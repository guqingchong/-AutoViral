{
  "name": "@nanxingw/autocode-cli",
  "version": "0.2.0",
  "main": "electron/main.cjs",
  "description": "AutoViral — Self-evolving intelligence for Claude Code: skills, memory, and autonomous tasks",
  "type": "module",
  "bin": {
    "autocode": "dist/index.js",
    "autoviral": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "web/dist/",
    "electron/",
    "scripts/",
    "bin/",
    "docs/"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc && node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "build:frontend": "vite build",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:installer:bash": "bash scripts/build-installer.sh",
    "dev": "tsc --watch",
    "dev:frontend": "vite dev",
    "postinstall": "node -e \"console.log('postinstall: dependencies installed. Run \\\"npm run build\\\" to compile backend and frontend.')\"",
    "test": "vitest run"
  },
  "keywords": [
    "claude-code",
    "autocode",
    "autoviral",
    "ai",
    "agent",
    "automation",
    "claude"
  ],
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@types/dompurify": "^3.0.5",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.0.0",
    "commander": "^12.0.0",
    "dompurify": "^3.3.3",
    "dotenv": "^16.4.0",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "hono": "^4.0.0",
    "js-yaml": "^4.1.0",
    "lottie-web": "^5.13.0",
    "marked": "^17.0.4",
    "node-cron": "^3.0.0",
    "playwright": "^1.58.2",
    "ssh2": "^1.17.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanxingw/autocode.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
